# ==========================================
# ANNASETU / FOODBRIDGE ENVIRONMENT CONFIGURATION
# Copy this file to .env or configure in your deployment hosting dashboard.
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==========================================

# ------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite)
# ------------------------------------------
# Deployed Spring Boot API Base URL (e.g., https://api-foodbridge.onrender.com)
VITE_API_BASE_URL=

# Deployed Production WebSocket URL (e.g., wss://api-foodbridge.onrender.com)
VITE_WS_URL=

# Optional: Mapbox or OpenStreetMap Custom Key (if using custom tiles)
VITE_MAP_API_KEY=

# ------------------------------------------
# 2. SPRING BOOT BACKEND ENVIRONMENT VARIABLES
# ------------------------------------------
# Port injected dynamically by hosting platform (Render/Railway/Fly)
PORT=8081

# Managed MySQL / PostgreSQL Database Connection Properties
# (Example: jdbc:mysql://db.railway.app:3306/foodbridge?useSSL=true)
DATABASE_URL=jdbc:mysql://localhost:3306/fooddb
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# Spring Security JWT Signing Secret (Generate strong 256-bit secret for production)
JWT_SECRET=replace_with_a_secure_256_bit_random_secret_string_in_production

# Deployed FastAPI AI Service Base URL (e.g., https://ai-foodbridge.onrender.com)
AI_SERVICE_URL=http://localhost:8000

# Allowed CORS Origins for Backend (Comma-separated for multiple domains)
ALLOWED_ORIGINS=https://foodbridge.vercel.app,http://localhost:5173

# Geofence & Route Matching Parameters
MAX_ROUTE_DEVIATION_KM=2.0
MAX_VOLUNTEER_TO_SHELTER_DISTANCE_KM=5.0
MIN_MATCH_DISTANCE_METERS=100.0
GPS_ACCURACY_THRESHOLD_METERS=50.0
DELIVERY_GEOFENCE_RADIUS_METERS=100.0

# Timezone Setting
APP_TIMEZONE=Asia/Kolkata

# ------------------------------------------
# 3. FASTAPI AI SERVICE ENVIRONMENT VARIABLES
# ------------------------------------------
# Port injected dynamically by hosting platform (Render/Railway/Fly)
PORT=8000

# Google Gemini API Key for Multimodal Document Analysis (Optional)
GEMINI_API_KEY=

# ------------------------------------------
# 4. OTP / NOTIFICATION PROVIDER CONFIGURATION
# ------------------------------------------
# OTP Delivery Provider (Default: IN_MEMORY / SMS_GATEWAY)
OTP_PROVIDER=SYSTEM_IN_APP
OTP_API_KEY=
